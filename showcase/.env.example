# Tambo API Configuration
# Get your API key from your self-hosted Tambo instance:
# https://github.com/tambo-ai/tambo/blob/main/SELF-HOSTING.md
# Tambo Cloud is shutting down (signups closed; the API stops responding after
# October 31, 2026): https://tambo.co/blog/posts/tambo-is-shutting-down
NEXT_PUBLIC_TAMBO_API_KEY=your_api_key_here

# Optional: Custom Tambo API URL (set this to your self-hosted API URL)
# NEXT_PUBLIC_TAMBO_API_URL=https://api.tambo.co

# Optional: PostHog Analytics (omit for OSS deployments)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
